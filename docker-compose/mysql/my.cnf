[mysqld_safe]
socket          = /var/run/mysqld/mysqld.sock
nice            = 0

[mysqld]
user                              = mysql
pid-file                          = /var/run/mysqld/mysqld.pid
socket                            = /var/run/mysqld/mysqld.sock
port                              = 3306
basedir                           = /usr
datadir                           = /var/lib/mysql
lc-messages-dir                   = /usr/share/mysql
skip-external-locking
lower_case_table_names            = 1                      
default-time_zone                 = '+8:00'
skip-name-resolve                                             
open_files_limit                  = 65535                    

# ===================== sql_mode（5.7特有重点） =====================
# 5.7默认sql_mode含 ONLY_FULL_GROUP_BY、NO_AUTO_CREATE_USER 等，
# Django/Archery的部分统计类GROUP BY查询在严格模式下会报1055错误，
# 建议显式设置为如下（去掉ONLY_FULL_GROUP_BY，保留基本严格性和数据完整性检查）：
sql_mode                          = "STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"

# ===================== 字符集（5.7写法，无0900_ai_ci） =====================
character-set-server               = utf8mb4
collation-server                    = utf8mb4_general_ci     # 5.7无utf8mb4_0900_ai_ci；追求排序/比较更符合Unicode语义可用utf8mb4_unicode_ci（略慢）
innodb_file_format                  = Barracuda               # utf8mb4长索引前缀依赖，5.7.7+默认已是Barracuda，显式声明防止被模板重置
innodb_large_prefix                 = 1                       # 允许索引前缀超767字节，避免长varchar+utf8mb4建唯一索引报错

# ===================== 连接与线程 =====================
max_connections                    = 1000                    # 原默认151；Web并发用户+django-q多worker+定时任务连接数远超默认值
max_connect_errors                 = 10000
back_log                           = 1024
thread_cache_size                  = 128
table_open_cache                   = 4000
table_definition_cache             = 4000
interactive_timeout                = 600
wait_timeout                       = 600                     # 需与Django settings.py中CONN_MAX_AGE配合(建议<=此值)
                                                                # 避免 "MySQL server has gone away"，也避免连接假死堆积耗尽max_connections

# ===================== 查询缓存（5.7仍存在，必须显式关闭） =====================
query_cache_type                   = 0                        # 8.0已移除该功能，但5.7仍在，写并发场景下极易造成锁争用，务必显式关闭
query_cache_size                   = 0

# ===================== InnoDB 核心 =====================
innodb_buffer_pool_size            = 24G                      # 原512M严重不足；建议为物理内存的70~80%（示例按32G内存机器）
innodb_buffer_pool_instances       = 8                        # 经验值：buffer_pool_size / instances >= 1G
innodb_log_file_size               = 1G                       # 5.7无redo_log_capacity参数，仍用log_file_size*files_in_group控制总redo容量
innodb_log_files_in_group          = 2
innodb_log_buffer_size             = 64M
innodb_flush_log_at_trx_commit     = 1                        # 审核平台=合规审计系统，工单/执行记录不可丢，不建议为性能改为2
innodb_flush_method                = O_DIRECT
innodb_file_per_table               = 1
innodb_io_capacity                 = 2000                     # SSD场景；机械盘请调回200
innodb_io_capacity_max              = 4000
innodb_read_io_threads             = 8
innodb_write_io_threads            = 8
innodb_lock_wait_timeout           = 30
innodb_print_all_deadlocks          = 1
innodb_buffer_pool_dump_at_shutdown = 1                       # 重启后自动预热buffer pool，减少冷启动性能抖动
innodb_buffer_pool_load_at_startup  = 1
innodb_stats_on_metadata            = 0                       # 5.7默认可能因SHOW TABLE STATUS等频繁触发统计信息重算，关闭减少额外开销

# ===================== 临时表/排序/JOIN =====================
tmp_table_size                     = 256M                     # 工单列表、权限矩阵等多表JOIN/GROUP BY场景需要更大内存临时表
max_heap_table_size                = 256M                     # 必须与tmp_table_size保持一致
sort_buffer_size                   = 4M
join_buffer_size                   = 4M
read_rnd_buffer_size                = 4M

# ===================== Binlog（5.7写法） =====================
server-id                          = 100
log_bin                            = /data/mysql/binlog/mysql-bin.log    # 建议与datadir分盘
binlog_format                       = ROW
sync_binlog                        = 1                        # 与innodb_flush_log_at_trx_commit=1配套，保证审计数据零丢失
max_binlog_size                    = 500M
max_allowed_packet                 = 1024M
expire_logs_days                   = 7                        # 5.7用该参数（8.0起改用binlog_expire_logs_seconds）；原1天过短
                                                                 # binlog是回滚语句/审计追溯的基础链条，建议至少7天

# ===================== 慢日志/错误日志 =====================
slow_query_log                     = 1
slow_query_log_file                = /data/mysql/logs/mysql-slow.log     # 独立盘，避免和数据文件竞争IO
long_query_time                    = 0.5                      # 原1秒偏宽松；审核平台自身查询应更敏感地发现慢SQL
log_queries_not_using_indexes       = 0                        # 按需开启，日志量较大时建议关闭，配合pt-query-digest定期巡检
log_error                          = /data/mysql/logs/error.log

# ===================== 安全 =====================
local_infile                       = 0
symbolic-links                     = 0

[client]
default-character-set=utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet      = 1024M

!includedir /etc/mysql/conf.d/

